# --- API ---
# Production API origin (no trailing slash). Leave empty in development.
VITE_API_BASE_URL=https://pentacon-construction.runasp.net

# Optional: where "npm run dev" forwards /api and /uploads (defaults to the production API above).
# VITE_PROXY_TARGET=http://localhost:5080

# --- Contact form ---
# Any endpoint that accepts a JSON POST works (Formspree: https://formspree.io/f/xxxx, FormSubmit: https://formsubmit.co/ajax/you@company.com).
# If empty, the form falls back to opening the visitor's email app using "email" from src/config/site.js.
VITE_CONTACT_FORM_URL=
